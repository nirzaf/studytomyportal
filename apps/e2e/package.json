{
  "name": "@learnhouse/e2e",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "End-to-end UI acceptance tests for Studytomy Portal, driving a CLI-installed self-host like a human.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:studytomy": "playwright test features/studytomy",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium",
    "test:browser-egress": "bun test core/browser-egress-guard.test.ts",
    "typecheck": "tsc --noEmit",
    "test:identity": "bun test core/studytomyIdentity.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
