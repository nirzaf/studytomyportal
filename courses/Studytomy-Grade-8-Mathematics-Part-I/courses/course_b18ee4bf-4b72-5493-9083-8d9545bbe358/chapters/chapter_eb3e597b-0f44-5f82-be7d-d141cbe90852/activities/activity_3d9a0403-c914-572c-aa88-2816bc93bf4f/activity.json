        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "1. ",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": "4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "2. ",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": "No reflection axes; rotational order 2."
          }
        ]
