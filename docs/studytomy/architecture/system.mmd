%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","lineColor":"#47627c","primaryTextColor":"#172b45","clusterBkg":"#f4f8fc","clusterBorder":"#9bb2c8"},"flowchart":{"curve":"linear","nodeSpacing":26,"rankSpacing":38}}}%%
flowchart TB
  accTitle: Studytomy system architecture
  accDescr: LearnHouse HTTP and MCP share server authorization. Domain records and evidence are authoritative in PostgreSQL. Assets, caches, collaboration, and external model calls have separate boundaries.
  subgraph Clients["Client boundary"]
    WEB["Learner · educator · guardian<br/>Next.js / React"]
    TOOL["External AI client"]
  end
  subgraph APP["LearnHouse modular monolith · FastAPI"]
    API["HTTP API"]
    MCP["MCP adapter<br/>Existing registry and approval"]
    AUTH["LearnHouse authentication and RBAC<br/>Tenant · scope · entitlement · purpose"]
    NATIVE["Native courses, lessons and assignments"]
    CONTENT["Curriculum, review and immutable releases"]
    ALE["Diagnostics · tutor · practice · assessment<br/>Evidence · mastery · reviewed reports"]
    GROUND["Exact linked-source drafting<br/>Planned end-to-end"]
    GATE["Policy and access decisions<br/>Learner consent · exact release grant<br/>Guardian relationship · purpose · report version"]
    API --> AUTH
    MCP --> AUTH
    AUTH --> NATIVE & CONTENT & ALE & GROUND
    AUTH -. "policy checks" .-> GATE
    CONTENT --> NATIVE & ALE
    NATIVE -->|"native grade evidence"| ALE
  end
  subgraph DATA["Persistence and supporting services"]
    PG[("PostgreSQL + pgvector<br/>Authoritative policies, grants and relationships<br/>Versioned releases, attempts, evidence and reports<br/>Derived retrieval index")]
    FILES[("Protected file / object storage<br/>Source and reviewed assets")]
    REDIS[("Redis<br/>Cache and transient coordination")]
    COLLAB["Existing Yjs / Hocuspocus<br/>Board collaboration"]
  end
  MODEL["External model provider<br/>Approval-gated data transfer"]
  WEB --> API
  TOOL --> MCP
  WEB -->|"board JWT"| COLLAB
  CONTENT & NATIVE & ALE --> PG
  GATE -->|"resolve current authority"| PG
  CONTENT & GROUND --> FILES
  GROUND -->|"authorized retrieval"| PG
  API & COLLAB --> REDIS
  ALE & GROUND -->|"minimized context; validate output"| MODEL
  classDef implemented fill:#dceee8,stroke:#267560,color:#163b32;
  classDef partial fill:#dfedfa,stroke:#416f9a,color:#193b5e;
  classDef planned fill:#ede4f8,stroke:#745591,color:#392756;
  classDef gated fill:#fff1d6,stroke:#916518,color:#593c0b;
  class WEB,TOOL,API,AUTH,MCP,NATIVE,PG,FILES,REDIS,COLLAB implemented;
  class CONTENT,ALE partial;
  class GROUND planned;
  class GATE,MODEL gated;
  subgraph LEGEND["Status in inspected checkout"]
    direction LR
    I["Implemented"] ~~~ P["Partially Implemented"] ~~~ N["Planned"] ~~~ G["Approval-Gated"]
  end
  class I implemented;
  class P partial;
  class N planned;
  class G gated;
